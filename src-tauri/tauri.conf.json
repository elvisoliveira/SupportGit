{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SupportGit",
  "version": "0.1.0",
  "identifier": "com.elvisoliveira.supportgit",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run frontend:dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SupportGit",
        "width": 1100,
        "height": 760,
        "minWidth": 820,
        "minHeight": 580,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": []
  }
}
